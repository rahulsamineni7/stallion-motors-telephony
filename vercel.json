{
  "version": 2,
  "rewrites": [
    {
      "source": "/simulate/(.*)",
      "destination": "/api/simulate/$1"
    },
    {
      "source": "/kros/(.*)",
      "destination": "/api/kros/$1"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/audio/tts",
      "destination": "/api/audio/tts"
    },
    {
      "source": "/audio/fish-tts",
      "destination": "/api/audio/fish-tts"
    },
    {
      "source": "/debug-routing",
      "destination": "/api/debug-routing"
    }
  ]
}
