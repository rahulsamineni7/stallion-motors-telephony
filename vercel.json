{
  "version": 2,
  "rewrites": [
    {
      "source": "/audio_assets.js",
      "destination": "/api/index.py"
    },
    {
      "source": "/audio/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/simulate/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/kros/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
